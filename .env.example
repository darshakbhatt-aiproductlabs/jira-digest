# =============================================================================
# jira-digest — secrets template
# Copy to .env for local runs:  cp .env.example .env
# In CI, add each non-blank value as a GitHub Actions secret of the same name.
# =============================================================================

# --- Jira (required) ---------------------------------------------------------
# Atlassian API token: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# --- Config path (optional) --------------------------------------------------
# Path to the digest config file, relative to repo root. Defaults to config/digest.yml.
DIGEST_CONFIG=config/digest.yml

# --- Mode flags --------------------------------------------------------------
# DRY_RUN=1 writes the rendered email to dry_run_output/ and skips delivery.
DRY_RUN=0

# --- Gmail OAuth (optional — only if delivery.gmail is enabled) --------------
# Run scripts/get_gmail_token.py once locally to obtain these.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Generic SMTP (optional — only if delivery.smtp is enabled) --------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=1

# --- Slack (optional — only if delivery.slack is enabled) --------------------
# Bot token (xoxb-...) needs chat:write scope. Bot must be invited to the target channel.
# Or use SLACK_WEBHOOK_URL for a simpler incoming-webhook setup (less rich formatting).
SLACK_BOT_TOKEN=
SLACK_WEBHOOK_URL=

# --- Microsoft Teams (optional — only if delivery.teams is enabled) ----------
# Incoming webhook URL for the target Teams channel.
TEAMS_WEBHOOK_URL=

# --- GitHub Gist (optional — only if delivery.gist is enabled) ---------------
# Fine-grained PAT with the `gist` scope ONLY (no repo access needed).
# Used to upload the full HTML digest so Slack/Teams messages can link to a
# browser-renderable copy via htmlpreview.github.io.
# Create one at: https://github.com/settings/tokens?type=beta
GIST_PAT=

# --- Outbound proxy (optional) -----------------------------------------------
# Use if your Jira instance IP-allowlists and you need a fixed egress IP.
HTTPS_PROXY=
